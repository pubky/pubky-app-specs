{
  "bugs": {
    "url": "https://github.com/pubky/pubky-social-specs/issues"
  },
  "contributors": [
    "SHAcollision",
    "tipogi",
    "ok300"
  ],
  "description": "Pubky social data model specifications",
  "devDependencies": {
    "mocha": "^11.7.5",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./validationLimits": {
      "types": "./validationLimits.d.ts",
      "import": "./validationLimits.js",
      "require": "./validationLimits.cjs"
    },
    "./validationLimits.json": "./validationLimits.json",
    "./mimeTypes": {
      "types": "./mimeTypes.d.ts",
      "import": "./mimeTypes.js",
      "require": "./mimeTypes.cjs"
    },
    "./mimeTypes.json": "./mimeTypes.json"
  },
  "files": [
    "index.js",
    "index.cjs",
    "types.d.ts",
    "pubky_social_specs.js",
    "pubky_social_specs.cjs",
    "pubky_social_specs.d.ts",
    "pubky_social_specs_bg.wasm",
    "example.js",
    "validationLimits.json",
    "validationLimits.js",
    "validationLimits.cjs",
    "validationLimits.d.ts",
    "mimeTypes.json",
    "mimeTypes.js",
    "mimeTypes.cjs",
    "mimeTypes.d.ts"
  ],
  "homepage": "https://pubky.app",
  "keywords": [
    "pubky-social",
    "pubky-nexus",
    "specs"
  ],
  "license": "MIT",
  "main": "index.cjs",
  "module": "index.js",
  "name": "pubky-social-specs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubky/pubky-social-specs.git"
  },
  "scripts": {
    "build": "cargo run --bin bundle_specs_npm",
    "example": "node example.js",
    "test": "tsc --noEmit --strict types.d.ts validationLimits.d.ts mimeTypes.d.ts && tsc --noEmit --strict --module nodenext --moduleResolution nodenext types.d.ts validationLimits.d.ts mimeTypes.d.ts && mocha test.js"
  },
  "sideEffects": false,
  "type": "module",
  "types": "types.d.ts",
  "version": "1.0.0-alpha.4"
}
