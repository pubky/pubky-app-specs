{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": [],
    // The SDK's declarations need the DOM lib, which the engine has to compile without
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "files": ["index.ts", "adapters/pubky-sdk.ts", "host.d.ts"]
}
